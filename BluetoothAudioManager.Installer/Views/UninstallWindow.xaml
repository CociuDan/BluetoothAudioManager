<Window x:Class="BluetoothAudioManager.Installer.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BluetoothAudioManager.Installer.Views"
        Style="{StaticResource Page}"
        WindowStartupLocation="CenterScreen"
        Title="Uninstall Bluetooth Audio Manager"
        Width="480"
        SizeToContent="Height">
    <!-- The uninstaller's first page: what goes, and what stays. -->
    <Border Style="{StaticResource PageSurface}" Padding="28,24" MouseLeftButtonDown="Page_MouseLeftButtonDown">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <views:AppIconMark Width="40" Height="40" />
                <TextBlock Text="Uninstall Bluetooth Audio Manager" Margin="12,0,0,0" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Margin="0,16,0,0" FontSize="13" Text="This closes the app and removes, for everyone on this PC:" />
            <!-- On one line, as line breaks in the markup would start each line with a space. -->
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#CFCFCF" LineHeight="20">• The app, its updater and downloaded updates<LineBreak />• Its shortcuts and its entry in Installed apps<LineBreak />• Everyone's settings, Start with the System and notifications</TextBlock>
            <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#CFCFCF" TextWrapping="Wrap"
                       Text="Your Bluetooth pairings and sound output stay as they are." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Uninstall" Style="{StaticResource AccentButton}" Click="Uninstall_Click" />
                <Button Content="Cancel" Margin="8,0,0,0" Style="{StaticResource PageButton}"
                        IsCancel="True" IsDefault="True" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
