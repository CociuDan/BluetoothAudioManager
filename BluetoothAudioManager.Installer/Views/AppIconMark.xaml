<UserControl x:Class="BluetoothAudioManager.Installer.Views.AppIconMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!--
        The app icon, from Assets/AppIcon.svg: a gray speaker with a gap cut around the Bluetooth symbol.
        The gap is drawn in the pages' color, which looks the same as the icon's cut-out on their solid background.
        Sized by the page, through Width and Height.
    -->
    <Viewbox>
        <Canvas Width="24" Height="24">
            <Path Data="M10.5,15.6 H13.2 L16.8,12.6 V22.6 L13.2,19.6 H10.5 Z" Fill="#8A8A8A" Stroke="#8A8A8A"
                  StrokeThickness="0.8" StrokeLineJoin="Round" />
            <Path Data="M18.8,15.4 A3.4,3.4 0 0 1 18.8,19.8" Stroke="#8A8A8A" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path Data="M21,13.2 A6.2,6.2 0 0 1 21,22" Stroke="#8A8A8A" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Canvas>
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                        <TranslateTransform X="-2.4" Y="0.4" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Path Data="M6,7 L18,17 L12,22 V2 L18,7 L6,17" Stroke="#202020" StrokeThickness="5.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Path Data="M6,7 L18,17 L12,22 V2 L18,7 L6,17" Stroke="#FFFFFF" StrokeThickness="2.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
