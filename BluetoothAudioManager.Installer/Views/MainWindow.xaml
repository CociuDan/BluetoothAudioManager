<Window x:Class="BluetoothAudioManager.Installer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BluetoothAudioManager.Installer.Views"
        Style="{StaticResource Page}"
        Title="Install Bluetooth Audio Manager"
        Width="480"
        SizeToContent="Height">
    <!-- The installer's first page: where to install. The colors and sizes of the draft, the same in light and dark Windows themes. -->
    <Border Style="{StaticResource PageSurface}" Padding="28,24" MouseLeftButtonDown="Page_MouseLeftButtonDown">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <views:AppIconMark Width="40" Height="40" />
                <TextBlock Text="Install Bluetooth Audio Manager" Margin="12,0,0,0" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Label Content="Install _to" Target="{Binding ElementName=FolderBox}" Margin="0,16,0,0" Padding="0"
                   FontSize="13" Foreground="#FFFFFF" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" Height="32" Padding="6,0" FontSize="12" VerticalContentAlignment="Center"
                         Foreground="#FFFFFF" Background="#2D2D2D" CaretBrush="#FFFFFF" SelectionBrush="#60CDFF"
                         BorderBrush="#4A4A4A" BorderThickness="1" TextChanged="FolderBox_TextChanged"
                         AutomationProperties.Name="Install to" />
                <Button Grid.Column="1" Content="Browse…" MinWidth="0" Margin="8,0,0,0" Padding="12,0"
                        Style="{StaticResource PageButton}" Click="Browse_Click" />
            </Grid>
            <TextBlock x:Name="FolderNote" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#CFCFCF" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="InstallButton" Content="Install" Style="{StaticResource AccentButton}"
                        IsDefault="True" Click="Install_Click" />
                <Button Content="Cancel" Margin="8,0,0,0" Style="{StaticResource PageButton}"
                        IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
