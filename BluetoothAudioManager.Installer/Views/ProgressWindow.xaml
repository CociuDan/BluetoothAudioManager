<Window x:Class="BluetoothAudioManager.Installer.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BluetoothAudioManager.Installer.Views"
        Style="{StaticResource Page}"
        Title="Bluetooth Audio Manager"
        Width="400"
        Height="240">
    <!-- The install and uninstall progress page: the icon, what's happening and how far it's got. -->
    <Border Style="{StaticResource PageSurface}" MouseLeftButtonDown="Page_MouseLeftButtonDown">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <views:AppIconMark Width="72" Height="72" HorizontalAlignment="Center" />
            <TextBlock x:Name="MessageText" Margin="0,18,0,0" FontSize="14" HorizontalAlignment="Center" />
            <Border Width="280" Height="4" Margin="0,18,0,0" CornerRadius="2" Background="#3A3A3A" ClipToBounds="True">
                <Border x:Name="Bar" Width="0" HorizontalAlignment="Left" CornerRadius="2" Background="#60CDFF" />
            </Border>
        </StackPanel>
    </Border>
</Window>
