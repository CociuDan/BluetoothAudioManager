<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows service the installer sets up. It runs with administrator rights so updates can install in Program Files
    without asking: it checks the GitHub releases, downloads and checks a new version, and installs it when the app asks.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyTitle>Bluetooth Audio Manager Updater</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BluetoothAudioManager.Shared\BluetoothAudioManager.Shared.csproj" />
  </ItemGroup>

  <!--
    The pipeline sets UpdateToken from a repository secret: a read-only token that lets the updater download releases
    from the private repository. It's never in the code, and builds made elsewhere don't have it.
  -->
  <ItemGroup Condition="'$(UpdateToken)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateToken</_Parameter1>
      <_Parameter2>$(UpdateToken)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
