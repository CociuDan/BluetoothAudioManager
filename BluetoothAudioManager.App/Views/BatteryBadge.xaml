<UserControl x:Class="BluetoothAudioManager.App.Views.BatteryBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="26">
    <StackPanel x:Name="BadgeArea" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center">
        <Border x:Name="Badge" CornerRadius="6" Padding="9,0">
            <TextBlock x:Name="PercentText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Border>
        <!-- Zero width, so the bolt sits beside the badge without moving it off center. -->
        <Canvas Width="0">
            <Path x:Name="ChargingIcon" Visibility="Collapsed" Canvas.Left="4" Canvas.Top="3" Width="14" Height="20" Stretch="Uniform"
                  Data="M6,0 L0,8 H4 L3,14 L10,5 H6 Z" Fill="{DynamicResource SystemFillColorSuccessBrush}"
                  ToolTip="Charging" AutomationProperties.Name="Charging" />
        </Canvas>
    </StackPanel>
</UserControl>
