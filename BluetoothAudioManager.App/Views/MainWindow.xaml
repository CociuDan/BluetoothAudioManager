<Window x:Class="BluetoothAudioManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BluetoothAudioManager.App.Views"
        Title="Bluetooth Audio Manager"
        Width="420"
        Height="456"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Artwork.xaml" />
                <ResourceDictionary Source="/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#33808080" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ResizeEdge" TargetType="Thumb">
                <Setter Property="Cursor" Value="SizeNS" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E81123" />
                        <Setter Property="Foreground" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="Surface" CornerRadius="8" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="CaptionBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- The logo starts where the window's contents do, with the name after it. -->
                <StackPanel Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center">
                    <local:AppLogo Width="16" Height="16" />
                    <TextBlock Text="Bluetooth Audio Manager" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- The same size as the X, with the device rows' settings glyph. Highlighted while the settings are open. -->
                    <Button x:Name="SettingsButton" Style="{StaticResource CaptionButton}" Content="&#xE713;" FontSize="13"
                            Click="SettingsButton_Click" ToolTip="Settings" AutomationProperties.Name="Settings" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                            Click="CloseButton_Click" ToolTip="Hide" AutomationProperties.Name="Hide" />
                </StackPanel>
            </Grid>

            <!-- Shown while a downloaded update is ready to install. -->
            <Border x:Name="UpdateBar" Grid.Row="1" Visibility="Collapsed" Margin="30,4,20,0" Padding="12,8,8,8"
                    CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Width="16" Height="16" VerticalAlignment="Center" Data="M8,2 V10 M4.5,6.5 L8,10 L11.5,6.5 M3,13 H13"
                          Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <TextBlock x:Name="UpdateText" Grid.Column="1" Margin="10,0" FontSize="13" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="Update now" Height="30" Padding="14,0" FontSize="13"
                            Click="UpdateButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="4" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- The app's settings, in place of the devices while the gear is on. -->
            <ScrollViewer x:Name="AppSettingsArea" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <local:AppSettingsPanel x:Name="AppSettingsView" Margin="30,16,20,20" />
            </ScrollViewer>

            <!-- Hidden as a whole while the settings are open, so the devices and the no-devices message keep their own state. -->
            <Grid x:Name="DevicesView" Grid.Row="2">
            <StackPanel x:Name="NoDevicesPanel" Margin="30,40,20,20" Visibility="Collapsed">
                <TextBlock Text="No paired headphones found" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Pair them in Windows' Bluetooth settings and they'll appear here." FontSize="12"
                           Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer x:Name="DevicesScroller" VerticalScrollBarVisibility="Disabled">
            <Grid x:Name="DevicesArea">
            <!--
                The left margin is 8, plus 22 inside each row for the drag handle, so content still starts 30 from the edge.
                Every row keeps 25 pixels for a divider above it, hidden on the first row, so all rows are the same height.
                The top margin of -5 makes up for that, so the first name still starts 20 from the top.
            -->
            <StackPanel x:Name="DevicesPanel" Margin="8,-5,20,20">
            <!-- A Border, like the other rows' UserControl, so it can be lifted as a card while dragged. -->
            <Border x:Name="AirPodsSection" Visibility="Collapsed">
            <StackPanel>
                <Border x:Name="AirPodsDivider" Height="1" Margin="22,12,0,12" Visibility="Hidden"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <local:DeviceHeader x:Name="AirPodsHeader" Title="AirPods" ShowSettings="True" />
                <Grid x:Name="AirPodsParts" Height="130" Margin="22,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <!-- Left pod first, then the right pod, then the case. -->
                    <StackPanel>
                        <Image x:Name="LeftPodPicture" Source="/Assets/Apple/AirPods4Pod-L.png" Height="96" Margin="0,0,0,8" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               ToolTip="Left pod" AutomationProperties.Name="Left pod" />
                        <local:BatteryBadge x:Name="LeftBattery" Label="L" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Image x:Name="RightPodPicture" Source="/Assets/Apple/AirPods4Pod-R.png" Height="96" Margin="0,0,0,8" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               ToolTip="Right pod" AutomationProperties.Name="Right pod" />
                        <local:BatteryBadge x:Name="RightBattery" Label="R" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <Image x:Name="CasePicture" Source="/Assets/Apple/AirPods4Case.png" Height="96" Margin="0,0,0,8" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               ToolTip="Case" AutomationProperties.Name="Case" />
                        <local:BatteryBadge x:Name="CaseBattery" />
                    </StackPanel>
                </Grid>

                <!-- The same height as the pictures it replaces, so nothing else moves. -->
                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Height="130" Margin="22,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ear detection" FontSize="14" />
                            <TextBlock Text="Pause when a pod comes out" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="EarDetectionText" Grid.Column="1" Text="Off" FontSize="12" Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <ToggleButton x:Name="EarDetectionToggle" Grid.Column="2" Style="{StaticResource SwitchStyle}"
                                      VerticalAlignment="Center" Click="EarDetectionToggle_Click"
                                      AutomationProperties.Name="Ear detection" />
                    </Grid>
                    <local:LowBatterySetting x:Name="AirPodsLowBattery" Margin="0,9,0,0" />
                </StackPanel>

            </StackPanel>
            </Border>
            </StackPanel>
            </Grid>
            </ScrollViewer>
            </Grid>

            <!-- The window has no Windows border to drag, so these edges resize it. The top one stops short of the X button. -->
            <Thumb Grid.RowSpan="3" Style="{StaticResource ResizeEdge}" Height="5" VerticalAlignment="Top" Margin="0,0,46,0"
                   DragDelta="TopEdge_DragDelta" DragCompleted="ResizeEdge_DragCompleted" />
            <Thumb Grid.RowSpan="3" Style="{StaticResource ResizeEdge}" Height="5" VerticalAlignment="Bottom"
                   DragDelta="BottomEdge_DragDelta" DragCompleted="ResizeEdge_DragCompleted" />
        </Grid>
    </Border>
</Window>
