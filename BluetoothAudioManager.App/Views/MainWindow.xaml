<Window x:Class="BluetoothAudioManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BluetoothAudioManager.App.Views"
        Title="Bluetooth Audio Manager"
        Width="420"
        Height="456"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Artwork.xaml" />
                <ResourceDictionary Source="/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#33808080" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ResizeEdge" TargetType="Thumb">
                <Setter Property="Cursor" Value="SizeNS" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E81123" />
                        <Setter Property="Foreground" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="Surface" CornerRadius="8" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="CaptionBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Bluetooth Audio Manager" Margin="30,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                        Click="CloseButton_Click" ToolTip="Hide" AutomationProperties.Name="Hide" />
            </Grid>

            <StackPanel x:Name="NoDevicesPanel" Grid.Row="1" Margin="30,40,20,20" Visibility="Collapsed">
                <TextBlock Text="No paired headphones found" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Pair them in Windows' Bluetooth settings and they'll appear here." FontSize="12"
                           Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer x:Name="DevicesScroller" Grid.Row="1" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DevicesPanel" Margin="30,20,20,20">
            <StackPanel x:Name="AirPodsSection" Visibility="Collapsed">
                <Border x:Name="AirPodsDivider" Height="1" Margin="0,12" Visibility="Collapsed"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <local:DeviceHeader x:Name="AirPodsHeader" Title="AirPods" ShowSettings="True" />
                <Grid x:Name="AirPodsParts" Height="130">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Image x:Name="RightPodPicture" Source="/Assets/AirPods4Pod-R.png" Height="96" Margin="0,0,0,8" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               ToolTip="Right pod" AutomationProperties.Name="Right pod" />
                        <local:BatteryBadge x:Name="RightBattery" Label="R" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Image x:Name="LeftPodPicture" Source="/Assets/AirPods4Pod-L.png" Height="96" Margin="0,0,0,8" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               ToolTip="Left pod" AutomationProperties.Name="Left pod" />
                        <local:BatteryBadge x:Name="LeftBattery" Label="L" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <Image x:Name="CasePicture" Source="/Assets/AirPods4Case.png" Height="96" Margin="0,0,0,8" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               ToolTip="Case" AutomationProperties.Name="Case" />
                        <local:BatteryBadge x:Name="CaseBattery" />
                    </StackPanel>
                </Grid>

                <!-- The same height as the pictures it replaces, so nothing else moves. -->
                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Height="130">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ear detection" FontSize="14" />
                            <TextBlock Text="Pause when a pod comes out" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="EarDetectionText" Grid.Column="1" Text="Off" FontSize="12" Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <ToggleButton x:Name="EarDetectionToggle" Grid.Column="2" Style="{StaticResource SwitchStyle}"
                                      VerticalAlignment="Center" Click="EarDetectionToggle_Click"
                                      AutomationProperties.Name="Ear detection" />
                    </Grid>
                    <local:LowBatterySetting x:Name="AirPodsLowBattery" Margin="0,9,0,0" />
                </StackPanel>

            </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <!-- The window has no Windows border to drag, so these edges resize it. The top one stops short of the X button. -->
            <Thumb Grid.RowSpan="2" Style="{StaticResource ResizeEdge}" Height="5" VerticalAlignment="Top" Margin="0,0,46,0"
                   DragDelta="TopEdge_DragDelta" DragCompleted="ResizeEdge_DragCompleted" />
            <Thumb Grid.RowSpan="2" Style="{StaticResource ResizeEdge}" Height="5" VerticalAlignment="Bottom"
                   DragDelta="BottomEdge_DragDelta" DragCompleted="ResizeEdge_DragCompleted" />
        </Grid>
    </Border>
</Window>
