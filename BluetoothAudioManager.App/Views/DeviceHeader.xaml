<UserControl x:Class="BluetoothAudioManager.App.Views.DeviceHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!--
            Its own template, because the theme's button changes color on hover and press.
            Every header button has this fixed height, so rows look the same whichever buttons they show.
        -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The square icon buttons: output, reconnect and settings. -->
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <!-- The text button: connect and disconnect. -->
        <Style x:Key="HeaderTextButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Padding" Value="16,0" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Button x:Name="OutputButton" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE7F6;"
                        Click="OutputButton_Click" IsEnabled="False" Margin="0,0,8,0"
                        ToolTip="Use as system output" AutomationProperties.Name="Use as system output" />
                <Button x:Name="ConnectButton" Style="{StaticResource HeaderTextButtonStyle}" Content="Connect"
                        Click="ConnectButton_Click" IsEnabled="False" />
                <Button x:Name="ReconnectButton" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE895;"
                        Click="ReconnectButton_Click" IsEnabled="False" Margin="8,0,0,0"
                        ToolTip="Reconnect" AutomationProperties.Name="Reconnect" />
                <Button x:Name="SettingsButton" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE713;"
                        Click="SettingsButton_Click" IsEnabled="False" Margin="8,0,0,0" Visibility="Collapsed"
                        ToolTip="Settings" AutomationProperties.Name="Settings" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="MessageText" Height="20" Margin="0,4,0,12" TextTrimming="CharacterEllipsis" />
    </StackPanel>
</UserControl>
