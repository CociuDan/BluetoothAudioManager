<UserControl x:Class="BluetoothAudioManager.App.Views.AppSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/Resources/Styles.xaml" />
    </UserControl.Resources>
    <!-- The app's own settings, shown in the window in place of the devices while the gear is on. -->
    <StackPanel>
        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Start with Windows" FontSize="14" />
            <TextBlock x:Name="StartupText" Grid.Column="1" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
            <ToggleButton x:Name="StartupToggle" Grid.Column="2" Style="{StaticResource SwitchStyle}"
                          VerticalAlignment="Center" Click="StartupToggle_Click"
                          AutomationProperties.Name="Start with Windows" />
        </Grid>

        <!-- Only for the installed app, which has an updater to ask. -->
        <Grid x:Name="AutomaticUpdatesRow" Margin="0,20,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Check for updates automatically" FontSize="14" />
            <TextBlock x:Name="AutomaticUpdatesText" Grid.Column="1" FontSize="12" Margin="8,0,8,0" VerticalAlignment="Center" />
            <ToggleButton x:Name="AutomaticUpdatesToggle" Grid.Column="2" Style="{StaticResource SwitchStyle}"
                          VerticalAlignment="Center" Click="AutomaticUpdatesToggle_Click"
                          AutomationProperties.Name="Check for updates automatically" />
        </Grid>

        <!-- Only for the installed app, which has an updater to ask. -->
        <Grid x:Name="UpdatesRow" Margin="0,20,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Updates" FontSize="14" VerticalAlignment="Center" />
            <Button x:Name="CheckNowButton" Grid.Column="1" Content="Check now" Height="30" MinWidth="96" Padding="14,0"
                    Margin="12,0,0,0" FontSize="13" VerticalAlignment="Center" Click="CheckNowButton_Click" />
        </Grid>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
                 <Label Content="_Transparency" Target="{Binding ElementName=TransparencySlider}" Padding="0" FontSize="14"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="TransparencyText" Grid.Column="1" FontSize="12" VerticalAlignment="Bottom" />
        </Grid>
        <Slider x:Name="TransparencySlider" Margin="0,8,0,0" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="TransparencySlider_ValueChanged"
                PreviewMouseWheel="TransparencySlider_PreviewMouseWheel" AutomationProperties.Name="Transparency" />
        <Grid Margin="0,2,0,0">
            <TextBlock Text="Solid" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="100%, the most" FontSize="11" HorizontalAlignment="Right"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
    </StackPanel>
</UserControl>
