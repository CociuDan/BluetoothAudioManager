<UserControl x:Class="BluetoothAudioManager.App.Views.DeviceListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/Resources/Styles.xaml" />
    </UserControl.Resources>
    <!-- Every paired device, hidden ones too, to reorder and to choose which ones the app shows. The pencil next to the gear opens it. -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Edit the list" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Done" Height="30" MinWidth="64" Padding="14,0" FontSize="13"
                    Click="DoneButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
        <TextBlock Text="Drag to reorder. Hidden devices stay paired in Windows." FontSize="12" Margin="0,4,0,12"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- One line per device, all the same height, so the line under the pointer is found from its height alone. -->
        <StackPanel x:Name="EntriesPanel" Background="Transparent"
                    MouseMove="EntriesPanel_MouseMove" MouseLeftButtonUp="EntriesPanel_MouseLeftButtonUp"
                    LostMouseCapture="EntriesPanel_LostMouseCapture" />
    </StackPanel>
</UserControl>
