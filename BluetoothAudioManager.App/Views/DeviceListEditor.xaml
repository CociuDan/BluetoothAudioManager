<UserControl x:Class="BluetoothAudioManager.App.Views.DeviceListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/Resources/Styles.xaml" />
    </UserControl.Resources>
    <!--
        Every paired device, hidden ones too, to reorder and to choose which ones the app shows.
        The pencil next to the gear opens it and goes back to the devices, as the gear does for the settings.
    -->
    <StackPanel>
        <TextBlock Text="Edit the list" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Drag to reorder. Hidden devices stay paired in Windows." FontSize="12" Margin="0,4,0,12"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- One line per device, all the same height, so the line under the pointer is found from its height alone. -->
        <StackPanel x:Name="EntriesPanel" Background="Transparent"
                    MouseMove="EntriesPanel_MouseMove" MouseLeftButtonUp="EntriesPanel_MouseLeftButtonUp"
                    LostMouseCapture="EntriesPanel_LostMouseCapture" />
    </StackPanel>
</UserControl>
