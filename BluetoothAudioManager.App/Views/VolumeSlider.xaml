<UserControl x:Class="BluetoothAudioManager.App.Views.VolumeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The speaker shows on the window itself, with no box around it. -->
            <Style x:Key="MuteButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="16" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Windows' volume for the device: the mute button, the slider, then the level. -->
    <Grid x:Name="Root" Height="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>
        <Button x:Name="MuteButton" Style="{StaticResource MuteButtonStyle}" Content="&#xE767;" Click="MuteButton_Click"
                ToolTip="Mute" AutomationProperties.Name="Mute" />
        <Slider x:Name="LevelSlider" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" TickFrequency="2" IsSnapToTickEnabled="True"
                ValueChanged="LevelSlider_ValueChanged" PreviewMouseWheel="LevelSlider_PreviewMouseWheel"
                AutomationProperties.Name="Volume" />
        <TextBlock x:Name="LevelText" Grid.Column="2" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
</UserControl>
