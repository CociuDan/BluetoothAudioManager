<UserControl x:Class="BluetoothAudioManager.App.HeadphoneRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BluetoothAudioManager.App">
    <StackPanel>
        <Border x:Name="Divider" Height="1" Margin="0,12" Visibility="Collapsed"
                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <local:DeviceHeader x:Name="Header" />
        <Image x:Name="Picture" Width="96" Height="96" HorizontalAlignment="Left"
               ToolTip="Headphones" AutomationProperties.Name="Headphones" />
    </StackPanel>
</UserControl>
