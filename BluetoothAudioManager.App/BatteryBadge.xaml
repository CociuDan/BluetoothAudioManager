<UserControl x:Class="BluetoothAudioManager.App.BatteryBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="26">
    <Border x:Name="Badge" Visibility="Collapsed" CornerRadius="6" Padding="9,0" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="PercentText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Path x:Name="ChargingIcon" Visibility="Collapsed" Margin="4,0,0,0" Width="10" Height="14" Stretch="Uniform"
                  Data="M6,0 L0,8 H4 L3,14 L10,5 H6 Z" VerticalAlignment="Center"
                  ToolTip="Charging" AutomationProperties.Name="Charging" />
        </StackPanel>
    </Border>
</UserControl>
