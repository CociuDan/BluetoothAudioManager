<Window x:Class="BluetoothAudioManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bluetooth Audio Manager"
        Width="420"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="BatteryIcon" TargetType="Path">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Geometry x:Key="PodGeometry">F1 M3.5,7 A5.5,5.5 0 1 1 14.5,7 A5.5,5.5 0 1 1 3.5,7 Z M11,7 H14.5 V20.5 A1.75,1.75 0 0 1 11,20.5 Z</Geometry>
        <Geometry x:Key="CaseGeometry">F1 M3,10 V9 A4,4 0 0 1 7,5 H17 A4,4 0 0 1 21,9 V10 Z M3,11 H21 V15 A4,4 0 0 1 17,19 H7 A4,4 0 0 1 3,15 Z</Geometry>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="ModelText" Text="Looking for AirPods" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="ConnectionText" Margin="0,4,0,0" Text="Checking connection" />
        <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click" IsEnabled="False"
                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="16,4" />
        <TextBlock x:Name="StatusText" Margin="0,4,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   Text="Open the case near this PC, or take a pod out." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Path Grid.Row="0" Style="{StaticResource BatteryIcon}" Data="{StaticResource PodGeometry}"
                  ToolTip="Left pod" AutomationProperties.Name="Left pod"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </Path.RenderTransform>
            </Path>
            <ProgressBar x:Name="LeftBar" Grid.Row="0" Grid.Column="1" Height="12" Maximum="100" />
            <TextBlock x:Name="LeftText" Grid.Row="0" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" />

            <Path Grid.Row="1" Style="{StaticResource BatteryIcon}" Data="{StaticResource PodGeometry}"
                  ToolTip="Right pod" AutomationProperties.Name="Right pod" />
            <ProgressBar x:Name="RightBar" Grid.Row="1" Grid.Column="1" Height="12" Maximum="100" />
            <TextBlock x:Name="RightText" Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" />

            <Path Grid.Row="2" Style="{StaticResource BatteryIcon}" Data="{StaticResource CaseGeometry}"
                  ToolTip="Case" AutomationProperties.Name="Case" />
            <ProgressBar x:Name="CaseBar" Grid.Row="2" Grid.Column="1" Height="12" Maximum="100" />
            <TextBlock x:Name="CaseText" Grid.Row="2" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   Text="AirPods report battery in 10% steps. The case usually reports only with a pod inside and the lid open. Levels are cleared when the AirPods disconnect." />
    </StackPanel>
</Window>
