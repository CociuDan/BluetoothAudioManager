<UserControl x:Class="BluetoothAudioManager.App.DeviceHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Its own template, because the theme's button changes color on hover and press. -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Button x:Name="OutputButton" Style="{StaticResource HeaderButtonStyle}" Content="&#xE7F6;"
                        Click="OutputButton_Click" IsEnabled="False"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                        MinWidth="0" Width="36" Margin="0,0,8,0" Padding="0" VerticalAlignment="Stretch"
                        ToolTip="Use as system output" ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="Use as system output" />
                <Button x:Name="ConnectButton" Style="{StaticResource HeaderButtonStyle}" Content="Connect" Click="ConnectButton_Click" IsEnabled="False"
                        MinWidth="100" Padding="16,4" />
                <Button x:Name="ReconnectButton" Style="{StaticResource HeaderButtonStyle}" Content="&#xE895;" Click="ReconnectButton_Click" IsEnabled="False"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                        MinWidth="0" Width="36" Margin="8,0,0,0" Padding="0" VerticalAlignment="Stretch"
                        ToolTip="Reconnect" ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="Reconnect" />
                <Button x:Name="SettingsButton" Style="{StaticResource HeaderButtonStyle}" Content="&#xE713;" Visibility="Collapsed"
                        Click="SettingsButton_Click"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                        MinWidth="0" Width="36" Margin="8,0,0,0" Padding="0" VerticalAlignment="Stretch"
                        ToolTip="Settings" AutomationProperties.Name="Settings" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="MessageText" Height="20" Margin="0,4,0,12" TextTrimming="CharacterEllipsis" />
    </StackPanel>
</UserControl>
