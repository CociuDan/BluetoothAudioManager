<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BluetoothAudioManager.Core\BluetoothAudioManager.Core.csproj" />
    <ProjectReference Include="..\BluetoothAudioManager.Shared\BluetoothAudioManager.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows notifications with buttons, for the update. -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- The name Windows shows for the program, such as on its notifications, and the uninstaller looks for. -->
    <AssemblyTitle>Bluetooth Audio Manager</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\TrayIcon.ico" />
    <Resource Include="Assets\**\*.png" />
    <!-- Only the tray icon uses Windows Forms, so its names shouldn't clash with WPF's across the app. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
